# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexus_store?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Google sign-in (optional). Leave either value empty to hide the Google button.
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# Google Sheets Integration
GOOGLE_SHEETS_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Private Key\n-----END PRIVATE KEY-----"
GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id"

# OpenAI (for AI features)
OPENAI_API_KEY="sk-your-openai-api-key"

# Contact Form (Resend)
RESEND_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Contact <onboarding@resend.dev>"
CONTACT_EMAIL="xxxxxxxxxxxxxxxxxxxxxxx"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Nexus Digital Store"

# File Storage (optional - for cloud storage)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"
# Public base URL for portfolio files when PORTFOLIO_STORAGE=s3 (no trailing slash).
# The bucket (or this CDN) must allow public reads. Object ACLs are not set.
AWS_S3_PUBLIC_URL=""

# Portfolio uploads. Default "local" writes to public/uploads/portfolio (fine on your PC).
# Vercel's filesystem is ephemeral, so production needs blob or s3:
#   PORTFOLIO_STORAGE=blob  and  BLOB_READ_WRITE_TOKEN from a Vercel Blob store
#   PORTFOLIO_STORAGE=s3    and the AWS_* variables above
PORTFOLIO_STORAGE="local"
BLOB_READ_WRITE_TOKEN=""

# Order file delivery email (products without a Payhip link).
# Option A — SMTP, e.g. Gmail with an App Password (myaccount.google.com/apppasswords):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
# Option B — Resend (requires a verified sending domain to email customers):
# RESEND_API_KEY="re_..."
# Optional sender override, e.g. "Alsadi Digital Store <you@gmail.com>"
EMAIL_FROM=""
# Optional; falls back to NEXTAUTH_SECRET. Signs expiring download links.
DOWNLOAD_TOKEN_SECRET=""
