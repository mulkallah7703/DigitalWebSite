model PortfolioNavLink {
  id        String @id @default(cuid())
  href      String
  labelAr   String
  labelEn   String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioStat {
  id        String @id @default(cuid())
  value     String
  labelAr   String
  labelEn   String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioSkillGroup {
  id        String           @id @default(cuid())
  titleAr   String
  titleEn   String
  sortOrder Int              @default(0)
  items     PortfolioSkill[]

  @@index([sortOrder])
}

model PortfolioSkill {
  id        String              @id @default(cuid())
  groupId   String
  group     PortfolioSkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  textAr    String
  textEn    String
  sortOrder Int                 @default(0)

  @@index([groupId])
}

model PortfolioJob {
  id        String               @id @default(cuid())
  datesAr   String
  datesEn   String
  titleAr   String
  titleEn   String
  companyAr String
  companyEn String
  sortOrder Int                  @default(0)
  bullets   PortfolioJobBullet[]

  @@index([sortOrder])
}

model PortfolioJobBullet {
  id        String       @id @default(cuid())
  jobId     String
  job       PortfolioJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  textAr    String
  textEn    String
  sortOrder Int          @default(0)

  @@index([jobId])
}

model PortfolioInnovation {
  id        String @id @default(cuid())
  badgeAr   String
  badgeEn   String
  nameAr    String
  nameEn    String
  bodyAr    String
  bodyEn    String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioProject {
  id        String @id @default(cuid())
  nameAr    String
  nameEn    String
  descAr    String
  descEn    String
  tags      String @default("")
  demoUrl   String @default("")
  imageUrl  String @default("")
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioEducation {
  id        String @id @default(cuid())
  datesAr   String
  datesEn   String
  degreeAr  String
  degreeEn  String
  schoolAr  String @default("")
  schoolEn  String @default("")
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioCertificate {
  id        String @id @default(cuid())
  textAr    String
  textEn    String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioResearchItem {
  id        String @id @default(cuid())
  nameAr    String
  nameEn    String
  bodyAr    String
  bodyEn    String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioSpokenLanguage {
  id        String @id @default(cuid())
  nameAr    String
  nameEn    String
  levelAr   String
  levelEn   String
  sortOrder Int    @default(0)

  @@index([sortOrder])
}

model PortfolioSocial {
  id          String  @id @default(cuid())
  label       String
  url         String
  followersAr String  @default("")
  followersEn String  @default("")
  showInHero  Boolean @default(false)
  heroOrder   Int     @default(0)
  sortOrder   Int     @default(0)

  @@index([sortOrder])
}
